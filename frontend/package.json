{
  "name": "@workspace/bd-services",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --host 0.0.0.0 --port 4200 --serve-path /bd-services --proxy-config proxy.conf.json",
    "build": "ng build --base-href /bd-services/",
    "serve": "ng build --base-href /bd-services/ --configuration development && npx http-server dist/public/browser -p 4200 -a 0.0.0.0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "^20.3.29",
    "@angular/compiler": "^20.3.29",
    "@angular/core": "^20.3.29",
    "@angular/forms": "^20.3.29",
    "@angular/platform-browser": "^20.3.29",
    "@angular/router": "^20.3.29",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.29",
    "http-server": "^14.1.1",
    "typescript": "~5.9.2"
  }
}
