{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public/browser",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/bd-services/api/:path*", "destination": "https://sheba-path.onrender.com/bd-services/api/:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/bd-services", "destination": "/index.html" },
    { "source": "/bd-services/:path*", "destination": "/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
